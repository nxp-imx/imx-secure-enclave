#Use injected KEK to inject another key - verifies key exchange worked as expected
HSM_MANAGE_KEY
0x02  # <= KEY_MGMT
14  # KEY ID
5  # KEK ID
0x02  # flags create
0x3c  # Input Size
0x32  # Key Type HSM_KEY_TYPE_AES_256
0x01  # Key group
0x02  # Key info - transient
0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
0x08, 0x09, 0x0A, 0x0B,
0x47, 0x03, 0xd4, 0x18, 0xc1, 0xe0, 0xc4, 0x1c,
0x85, 0x48, 0x9d, 0x80, 0xbd, 0xe4, 0x76, 0x62,
0x93, 0xc7, 0x95, 0x27, 0xe4, 0x6e, 0x49, 0x6b,
0x20, 0x7e, 0xff, 0x9e, 0x01, 0x74, 0x1e, 0xad,
0x5e, 0xdd, 0xdc, 0x50, 0x74, 0x04, 0x4e, 0x22,
0x82, 0xb4, 0x32, 0xb3, 0xf2, 0xd8, 0xf6, 0x73 # encrypted key
0x00  # [check] expected return value (HSM_NO_ERROR)

