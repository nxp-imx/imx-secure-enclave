## \file
#
# Test bit granularity with 24 bits
#
HSM_OPEN_SESSION
0 # session index (uint32_t)
0x51 # Read value (uint8_t)
0 # Check value (err)
1 # Check if pointer ok

## \file
# - Open key store with 24 bits as min mac length
HSM_OPEN_KEY_STORE_SERVICE
0 # session index (uint32_t)
2 # key store id  (uint32_t)
0 # Read value (uint32_t)
0 # Read value (uint16_t)
9 # Read value (hsm_svc_key_store_flags_t): create + set_bit_len
24 # Read value (uint8_t) min mac length in bits
2 # key store index (uint32_t)
0 # Check value (err)
1 # Check if pointer ok (testCtx->hdl[new_hdl_index]) -- 0=

HSM_OPEN_KEY_MANAGEMENT_SERVICE
2 # key_store index (uint32_t)
0 # Read value (hsm_svc_key_management_flags_t)
3 # key management index (uint32_t)
0 # Check value (err)
1 # Check if pointer ok (testCtx->hdl[new_hdl_index]) -- 0=

HSM_OPEN_MAC_SERVICE
2 # key store index (uint32_t)
0 # Read value (hsm_svc_cipher_flags_t)
4 # mac index (uint32_t)
0 # Check value (err)
1 # Check if pointer ok (testCtx->hdl[cipher_hdl_index]) -- 0=

HSM_GENERATE_KEY
3 # key management index
2 # key_id
0 # Out_size : no key
2 # flags : Create
0x32 # key_type AES_256
1 # key_group
0 # key_info
0x00 # Out_pub_key
0 # check value (err)
NULL # out pub_key

## \file
# - Generate a MAC with key 1
< 1 MAC Gen >
HSM_MAC_ONE_GO
4 # mac index (uint32_t)
2 # key_id_number
0 # mac message stored id
1 # algorithm CMAC
1 # flags - GENERATION
16 # payload size (uint32_t)
0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF # payload
0x04 # mac size (uint32_t) # 32 bit
0x00, 0x00, 0x00, 0x00 # mac
0, 0, 0, 0 # allocation verification status
0 # Check value (err) # HSM_NO_ERROR
NULL # mac expected value

HSM_GENERATE_KEY
3 # key management index
3 # key_id
0 # Out_size : no key
2 # flags : Create
0x32 # key_type AES_256
1 # key_group
0 # key_info
0x00 # Out_pub_key
0 # check value (err)
NULL # out pub_key

## \file
# - Generate a MAC with key 2
< 2 MAC Gen >
HSM_MAC_ONE_GO
4 # mac index (uint32_t)
3 # key_id_number
1 # mac message stored id
1 # algorithm CMAC
1 # flags - GENERATION
16 # payload size (uint32_t)
0x87, 0x98, 0xA9, 0xBA, 0xCB, 0xDC, 0xEF, 0xFC # payload
0x04, 0x14, 0x23, 0x32, 0x45, 0x56, 0x67, 0x79,
0x04 # mac size (uint32_t) # 32 bit
0x00, 0x00, 0x00, 0x00 # mac
0, 0, 0, 0 # allocation verification status
0 # Check value (err) # HSM_NO_ERROR
NULL # mac expected value

HSM_GENERATE_KEY
3 # key management index
4 # key_id
0 # Out_size : no key
2 # flags : Create
0x32 # key_type AES_256
1 # key_group
0 # key_info
0x00 # Out_pub_key
0 # check value (err)
NULL # out pub_key

## \file
# - Generate a MAC with key 3
< 3 MAC Gen >
HSM_MAC_ONE_GO
4 # mac index (uint32_t)
4 # key_id_number
2 # mac message stored id
1 # algorithm CMAC
1 # flags - GENERATION
16 # payload size (uint32_t)
0x01, 0x10, 0x1d, 0x3b, 0x3d, 0x4f, 0x7d, 0x68,
0x96, 0xa6, 0xB5, 0xCC, 0xD3, 0xE8, 0xFE, 0xF1 # payload
0x04 # mac size (uint32_t) # 32 bit
0x00, 0x00, 0x00, 0x00 # mac
0, 0, 0, 0 # allocation verification status
0 # Check value (err) # HSM_NO_ERROR
NULL # mac expected value

## \file
# - Generate a MAC with key 3
< 1 MAC Ver - bit granularity eq >
HSM_MAC_ONE_GO
4  # mac index (uint32_t)
2  # key_id_number
0  # mac message stored id
1 # algorithm CMAC
2 # flags - verification + mac length in bits
16 # payload size (uint32_t)
0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF # payload
24 # mac size
NULL # mac
0, 0, 0, 0 # allocation verification status
0 # Check value (err)
NULL # mac expected value
0xC6, 0xA1, 0x1A, 0x6C # expected verification status

## \file
# - Verify a MAC with mac size lower than min mac length
< 1 MAC Ver - bit granularity lo >
HSM_MAC_ONE_GO
4  # mac index (uint32_t)
2  # key_id_number
0  # mac message stored id
1 # algorithm CMAC
2 # flags - verification + mac length in bits
16 # payload size (uint32_t)
0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF # payload
23 # mac size
NULL # mac
0, 0, 0, 0 # allocation verification status
0x04 # Check value (err - invalid param)
NULL # mac expected value
0xC6, 0xA1, 0x1A, 0x6C # expected verification status

## \file
# - Verify a MAC with mac size higher than min mac length
< 1 MAC Ver - bit granularity hi >
HSM_MAC_ONE_GO
4  # mac index (uint32_t)
2  # key_id_number
0  # mac message stored id
1 # algorithm CMAC
2 # flags - verification + mac length in bits
16 # payload size (uint32_t)
0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF # payload
25 # mac size
NULL # mac
0, 0, 0, 0 # allocation verification status
0 # Check value (err)
NULL # mac expected value
0xC6, 0xA1, 0x1A, 0x6C # expected verification status

