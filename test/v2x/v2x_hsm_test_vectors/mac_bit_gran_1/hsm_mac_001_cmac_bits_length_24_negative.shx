0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF # payload
32 # mac size
NULL # mac
0, 0, 0, 0 # allocation verification status
0 # Check value (err)
NULL # mac expected value
0xC6, 0xA1, 0x1A, 0x6C # expected verification status

## \file
# - Verify a MAC with mac size equal to 0
< 2 MAC Ver - bit granularity >
HSM_MAC_ONE_GO
4  # mac index (uint32_t)
2  # key_id_number
0  # mac message stored id
1 # algorithm CMAC
2 # flags - verification + mac length in bits
16 # payload size (uint32_t)
0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF # payload
0x00 # mac size
NULL # mac
0, 0, 0, 0 # allocation verification status
0x04 # Check value (invalid param)
NULL # mac expected value
0xC6, 0xA1, 0x1A, 0x6C # expected verification status

## \file
# - Verify a MAC using byte granularity
< 3 MAC Ver - bytes >
HSM_MAC_ONE_GO
4  # mac index (uint32_t)
2  # key_id_number
0  # mac message stored id
1 # algorithm CMAC
0 # flags - verification
16 # payload size (uint32_t)
0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77,
0x88, 0x99, 0xAA, 0xBB, 0xCC, 0xDD, 0xEE, 0xFF # payload
0x00 # mac size
NULL # mac
0, 0, 0, 0 # allocation verification status
0 # Check value (err)
NULL # mac expected value
0xC6, 0xA1, 0x1A, 0x6C # expected verification status

HSM_CLOSE_MAC_SERVICE
4 # mac index (uint32_t)
0 # Check value (err)

HSM_CLOSE_KEY_MANAGEMENT_SERVICE
3 # Read value (uint32_t)
0 # Check value (err)

HSM_CLOSE_KEY_STORE_SERVICE
2 # key store index (uint32_t)
0 # Check value (err)

HSM_CLOSE_SESSION
0 # Read value (uint32_t)
0 # Check value (err)
