1234             #Key Management ID, KEY_MGMT_TV_ID to be used by tests


#Positive Case:
#Key Generation of ECC KEY PAIR SECP R1 NIST 384 key
TEST_KGEN_PSA_PERSISTENT_AP0201

KEY_MGMT_TV_ID      1234       # Key Management TV ID
KEY_TV_ID           201          # Key TV ID to use the key later
KEY_ID              0x0        # Key ID to be chosen by FW
OUT_SIZE            96        # Public Key Out Size
KEY_TYPE            0x7112     # HSM_KEY_TYPE_ECC_KEY_PAIR_SECP_R1_NIST_384
BIT_KEY_SZ          384       # HSM_KEY_SIZE_ECC_KEY_PAIR_SECP_R1_NIST_384
FLAGS               0x80          #
KEY_GROUP           80         # Key Group b/w 0-1023
KEY_LIFETIME        0x00000101 # HSM_SE_KEY_STORAGE_PERSISTENT
KEY_LIFECYCLE       0x01       # 0x01 indicates set to Open Device Lifecycle
KEY_USAGE           0x00004000 # HSM_KEY_USAGE_DERIVE
PERMITTED_ALGO      0x09020109 # PERMITTED_ALGO_ECDH_HKDF_SHA256
EXPECTED_HSM_RESP   0x00       # HSM_NO_ERROR

TEST_KGEN_END



