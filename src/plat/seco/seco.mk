MAJOR_VER := 0
MINOR_VER := 1
COMPATIBLE_MACHINE ?= mx95-nxp-bsp

V2X_HSM_TEST := v2x_hsm_test
V2X_SHE_TEST := v2x_she_test
SHE_LIB_NAME := lib_she
HSM_LIB_NAME := lib_hsm
NVM_LIB_NAME := lib_nvm

SO_EXT := so.${MAJOR_VER}.${MINOR_VER}
NVM_LIB := $(NVM_LIB_NAME).$(SO_EXT)
NVM_LIB_MAJOR := $(NVM_LIB_NAME).so.$(MAJOR_VER)
HSM_LIB := $(HSM_LIB_NAME).$(SO_EXT)
HSM_LIB_MAJOR := $(HSM_LIB_NAME).so.$(MAJOR_VER)
SHE_LIB := $(SHE_LIB_NAME).$(SO_EXT)
SHE_LIB_MAJOR := $(SHE_LIB_NAME).so.$(MAJOR_VER)

ifeq ($(COMPATIBLE_MACHINE), mx94-nxp-bsp)
include $(PLAT_COMMON_PATH)/prime_api/prime_api.mk
endif

INCLUDE_HEADERS_CP = cp -a include/common include/hsm include/crrm include/she include/nvm.h $(DESTDIR)$(INCLUDEDIR)
PSA := non_psa

# SHX Test Vectors name
MKDIR_SHE_TV = mkdir -p $(DESTDIR)$(SHE_TEST_VECTOR_DEFAULT_DIR)
MKDIR_V2X_HSM_TV = mkdir -p $(DESTDIR)$(V2X_HSM_TEST_VECTOR_DEFAULT_DIR)
EXPORT_SHE_SHX_TV = cp -r $(SHE_TEST_COMMON_TV_PATH) $(DESTDIR)$(SHE_TEST_VECTOR_DEFAULT_DIR)
EXPORT_SHE_SHX_README = cp -r $(SHE_TEST_README_PATH) $(DESTDIR)$(SHE_TEST_VECTOR_DEFAULT_DIR)
EXPORT_V2X_HSM_SHX_TV = cp -r $(V2X_HSM_TV_PATH) $(DESTDIR)$(V2X_HSM_TEST_VECTOR_DEFAULT_DIR)

ifeq ($(COMPATIBLE_MACHINE), mx8dxl-nxp-bsp)
HSM_TEST := $(PLAT)_hsm_test
SHE_TEST := $(PLAT)_she_test
EXPORT_NVM_DAEMON := cp $(NVM_DAEMON) $(DESTDIR)$(BINDIR)
EXPORT_NVMD_CONF_FILE := cp $(STAGE_DIR)/$(NVMD_CONF_FILE) $(DESTDIR)$(ETC_DIR)
EXPORT_SYSTEMD_NVM_SERVICE := cp $(STAGE_DIR)/$(SYSTEMD_NVM_SERVICE) $(DESTDIR)$(SYSTEMD_DIR)

#function to prepare the temporary/staging artifacts for SECO
define prepare_seco_stage_files
	mkdir -p $(STAGE_DIR)
	cp $(PLAT_COMMON_PATH)/nvm/$(NVMD_CONF_FILE) $(STAGE_DIR)
	cp $(PLAT_COMMON_PATH)/nvm/$(SYSTEMD_NVM_SERVICE) $(STAGE_DIR)
	sed -i "/^NVMD_STORAGE_FILENAME=/c\NVMD_STORAGE_FILENAME=/etc/hsm/seco_hsm_master" \
		$(STAGE_DIR)/$(NVMD_CONF_FILE)
	sed -i "/^NVMD_STORAGE_DIRNAME=/c\NVMD_STORAGE_DIRNAME=/etc/hsm/" \
		$(STAGE_DIR)/$(NVMD_CONF_FILE)
	sed -i "s/ELE/SECO/g" $(STAGE_DIR)/$(SYSTEMD_NVM_SERVICE)
endef
else
EXPORT_SHE_V2X_SHX_TV = cp -r $(SHE_TEST_V2X_TV_PATH) $(DESTDIR)$(SHE_TEST_VECTOR_DEFAULT_DIR)
endif

# V2X specific target artifacts names
TARGET_V2X_NVM_DAEMON := nvm_daemon_v2x
TARGET_V2X_SHE_NVMD_CONF_FILE := nvmd_v2x_she.conf
TARGET_V2X_SHE_SYSTEMD_NVM_SERVICE := nvm_daemon_v2x_she.service
TARGET_V2X_HSM_NVMD_CONF_FILE := nvmd_v2x_hsm.conf
TARGET_V2X_HSM_SYSTEMD_NVM_SERVICE := nvm_daemon_v2x_hsm.service
EXPORT_V2X_NVM_DAEMON := cp $(NVM_DAEMON) $(DESTDIR)$(BINDIR)/$(TARGET_V2X_NVM_DAEMON)
EXPORT_V2X_SHE_NVMD_CONF_FILE := cp $(STAGE_DIR)/$(TARGET_V2X_SHE_NVMD_CONF_FILE) $(DESTDIR)$(ETC_DIR)
EXPORT_V2X_SHE_SYSTEMD_NVM_SERVICE := cp $(STAGE_DIR)/$(TARGET_V2X_SHE_SYSTEMD_NVM_SERVICE) $(DESTDIR)$(SYSTEMD_DIR)
EXPORT_V2X_HSM_NVMD_CONF_FILE := cp $(STAGE_DIR)/$(TARGET_V2X_HSM_NVMD_CONF_FILE) $(DESTDIR)$(ETC_DIR)
EXPORT_V2X_HSM_SYSTEMD_NVM_SERVICE := cp $(STAGE_DIR)/$(TARGET_V2X_HSM_SYSTEMD_NVM_SERVICE) $(DESTDIR)$(SYSTEMD_DIR)

#function to prepare the temporary/staging artifacts for V2X
define prepare_v2x_stage_files
	mkdir -p $(STAGE_DIR)
	cp $(PLAT_COMMON_PATH)/nvm/$(NVMD_CONF_FILE) $(STAGE_DIR)/$(TARGET_V2X_SHE_NVMD_CONF_FILE)
	cp $(PLAT_COMMON_PATH)/nvm/$(SYSTEMD_NVM_SERVICE) $(STAGE_DIR)/$(TARGET_V2X_SHE_SYSTEMD_NVM_SERVICE)
	cp $(PLAT_COMMON_PATH)/nvm/$(NVMD_CONF_FILE) $(STAGE_DIR)/$(TARGET_V2X_HSM_NVMD_CONF_FILE)
	cp $(PLAT_COMMON_PATH)/nvm/$(SYSTEMD_NVM_SERVICE) $(STAGE_DIR)/$(TARGET_V2X_HSM_SYSTEMD_NVM_SERVICE)
	sed -i "/^NVMD_STORAGE_FILENAME=/c\NVMD_STORAGE_FILENAME=/etc/v2x_she/v2x_she_master" \
		$(STAGE_DIR)/$(TARGET_V2X_SHE_NVMD_CONF_FILE)
	sed -i "/^NVMD_STORAGE_DIRNAME=/c\NVMD_STORAGE_DIRNAME=/etc/v2x_she/" \
		$(STAGE_DIR)/$(TARGET_V2X_SHE_NVMD_CONF_FILE)
	sed -i "/^NVMD_MU_SESSION_FLAG=/c\NVMD_MU_SESSION_FLAG=0xC8" \
		$(STAGE_DIR)/$(TARGET_V2X_SHE_NVMD_CONF_FILE)
	sed -i "s/ELE/V2X SHE/g" $(STAGE_DIR)/$(TARGET_V2X_SHE_SYSTEMD_NVM_SERVICE)
	sed -i "s/$(NVMD_CONF_FILE)/$(TARGET_V2X_SHE_NVMD_CONF_FILE)/g" \
		$(STAGE_DIR)/$(TARGET_V2X_SHE_SYSTEMD_NVM_SERVICE)
	sed -i "s/$(NVM_DAEMON)/$(TARGET_V2X_NVM_DAEMON)/g" \
		$(STAGE_DIR)/$(TARGET_V2X_SHE_SYSTEMD_NVM_SERVICE)

	sed -i "/^NVMD_STORAGE_FILENAME=/c\NVMD_STORAGE_FILENAME=/etc/v2x_hsm/v2x_hsm_master" \
		$(STAGE_DIR)/$(TARGET_V2X_HSM_NVMD_CONF_FILE)
	sed -i "/^NVMD_STORAGE_DIRNAME=/c\NVMD_STORAGE_DIRNAME=/etc/v2x_hsm/" \
		$(STAGE_DIR)/$(TARGET_V2X_HSM_NVMD_CONF_FILE)
	sed -i "/^NVMD_MU_SESSION_FLAG=/c\NVMD_MU_SESSION_FLAG=0xD0" \
		$(STAGE_DIR)/$(TARGET_V2X_HSM_NVMD_CONF_FILE)
	sed -i "s/ELE/V2X HSM/g" $(STAGE_DIR)/$(TARGET_V2X_HSM_SYSTEMD_NVM_SERVICE)
	sed -i "s/$(NVMD_CONF_FILE)/$(TARGET_V2X_HSM_NVMD_CONF_FILE)/g" \
		$(STAGE_DIR)/$(TARGET_V2X_HSM_SYSTEMD_NVM_SERVICE)
	sed -i "s/$(NVM_DAEMON)/$(TARGET_V2X_NVM_DAEMON)/g" \
		$(STAGE_DIR)/$(TARGET_V2X_HSM_SYSTEMD_NVM_SERVICE)
endef

DEFINES		+=	-DLIB_MINOR_VERSION=${MINOR_VER}\
			-DCONFIG_COMPRESSED_ECC_POINT

PLAT_OBJECTS	:=	$(PLAT_PATH)/seco_os_abs_linux.o \
			$(PLAT_PATH)/seco_utils.o \
			$(PLAT_PATH)/plat_err.o

OBJECTS	+= $(PLAT_OBJECTS)
