MT_SAB_LC_UPDATE	:=	${NOT_SUPPORTED}
# Marking it as NOT_SUPPORTED as executing this API leads to in-correct observation:
# - SM will mask the ELE reset bit into the SRC register
#   (BLK_CTRL_S_AONMIX->S401_RESET_REQ_MASK);
#   it will lead to skipping any logging from the SM/SAF
# - As the PMIC will bounce VDD_SOC, the reset reason will be lost
#   and appears to be a POR.
MT_SAB_DEV_ELE_RESET	:=	${NOT_SUPPORTED}
MT_SAB_GET_EVENT	:=	${NOT_SUPPORTED}
MT_SAB_BLOB_UNBLOB	:=	${NOT_SUPPORTED}
MT_SAB_BOOT_STAGE	:=	${NOT_SUPPORTED}

